# ─── Turso Database ─────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Auth ────────────────────────────────────────────────────
# Must be a long random string — generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars

# ─── Admin ───────────────────────────────────────────────────
ADMIN_KEY=change-this-admin-key

# ─── App URL (used in email links & Stripe redirects) ────────
NEXT_PUBLIC_APP_URL=https://capitalcode.onrender.com

# ─── Resend (transactional email) ────────────────────────────
# Sign up at https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender domain in Resend
EMAIL_FROM=Capital Code <noreply@yourdomain.com>

# ─── Stripe ──────────────────────────────────────────────────
# Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://capitalcode.onrender.com/api/stripe/webhook
# Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Stripe Price IDs ────────────────────────────────────────
# Dashboard → Products → create each product → copy Price ID
STRIPE_PRICE_DIGITAL=price_...
STRIPE_PRICE_PHYSICAL=price_...
STRIPE_PRICE_BUNDLE=price_...
