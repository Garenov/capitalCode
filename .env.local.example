# ─── Turso Database ─────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string

# ─── Admin ───────────────────────────────────────────────────
ADMIN_KEY=change-this-admin-key

# ─── App URL (used in email links) ───────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Resend (email) ──────────────────────────────────────────
# Sign up at https://resend.com, get an API key
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified domain in Resend
EMAIL_FROM=Capital Code <noreply@yourdomain.com>

# ─── Stripe ──────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Get from https://dashboard.stripe.com/webhooks after creating the webhook
# Endpoint: https://yourdomain.com/api/stripe/webhook
# Events to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Stripe Price IDs ────────────────────────────────────────
# Create products in Stripe Dashboard, then paste Price IDs here
# https://dashboard.stripe.com/products
STRIPE_PRICE_DIGITAL=price_...
STRIPE_PRICE_PHYSICAL=price_...
STRIPE_PRICE_BUNDLE=price_...
